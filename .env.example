# Run python3 scripts/bootstrap.py to create .env with unique secrets.
# Never commit .env / .env.test. Every deployment has separate credentials.
COMPOSE_PROJECT_NAME=flowpilot
APP_PORT=3000
N8N_PORT=5678
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_FORM_ENABLED=true
COMPANY_NAME=星舟数智 · Starbridge Automation

POSTGRES_PASSWORD=
FLOWPILOT_DB_PASSWORD=
N8N_DB_PASSWORD=
FLOWPILOT_ADMIN_PASSWORD=
FLOWPILOT_SESSION_SECRET=
FLOWPILOT_WEBHOOK_KEY=
FLOWPILOT_INTERNAL_KEY=
FLOWPILOT_ENCRYPTION_KEY=
N8N_ENCRYPTION_KEY=

WORKFLOW_ENGINE=n8n
N8N_VERSION=2.46.6
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook/flowpilot
# Required for native final-state polling; create a key in n8n Settings > n8n API.
# The business pipeline still runs without it, but native final status is unknown.
N8N_API_KEY=

LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:1.5b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Explicit Ollama CPU/context limits. Large inputs fail visibly rather than truncate.
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_CTX=16384
FLOWPILOT_TEST_MODE=false
FLOWPILOT_ALLOW_FAULTS=false

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# FlowPilot derives secure-cookie mode from PUBLIC_BASE_URL=https://...
# For a public HTTPS n8n deployment, also set its base URL and enable this:
N8N_SECURE_COOKIE=false
